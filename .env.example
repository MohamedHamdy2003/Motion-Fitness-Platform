NODE_ENV=development
PORT=3100
DATABASE_URL=postgres://motion:motion_local_only@localhost:55432/motion
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-bytes-before-running
JWT_ISSUER=motion-api
JWT_AUDIENCE=motion-mobile
MAIL_MODE=disabled
# Local development only: MAIL_MODE=capture stores encrypted mail in DB; inspect with scripts/read-mail.ts.
MAIL_ENCRYPTION_KEY=
RESEND_API_KEY=
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ENCRYPTION_KEY=
AI_REWRITE_URL=
AI_SERVICE_TOKEN=
AI_RETENTION_APPROVED=false
# Age is strictly greater than 18; measurements never expire.
DELETION_RETENTION_APPROVED=false
CORS_ORIGINS=
TRUST_PROXY=false
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
