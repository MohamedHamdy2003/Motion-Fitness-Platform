meta {
  name: Matching honest status
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/me/matching/status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  test("F05 is not implemented",()=>expect(res.getBody().reason).to.equal("F05_NOT_IMPLEMENTED"));
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
