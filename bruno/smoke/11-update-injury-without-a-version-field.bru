meta {
  name: Update injury without a version field
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/me/injuries/{{injuryId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "body_area_code": "KNEE",
    "side": "LEFT",
    "description": "Last successful change",
    "confirmed": true
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  See docs/API_CONTRACT.md for response shapes and error codes.
  Never commit populated credentials or runtime tokens.
}
