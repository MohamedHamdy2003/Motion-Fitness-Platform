meta {
  name: Read current weight
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  test("Current weight without measurement history",()=>{const b=res.getBody();expect(Number(b.profile.weight_kg)).to.equal(80);expect(b).not.to.have.property("latest_weight");expect(b.profile).not.to.have.property("measured_at");});
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.3.0.
  See docs/API_CONTRACT.md for response shapes and error codes.
  Never commit populated credentials or runtime tokens.
}
