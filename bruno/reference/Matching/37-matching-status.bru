meta {
  name: Matching status
  type: http
  seq: 37
}

get {
  url: {{baseUrl}}/me/matching/status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Response: {status,runId,selectedProgramVersionId,reasonCodes,failureCode,assignmentStatus,enrollmentId,createdAt}. Before a run: {status:"NOT_STARTED",runId:null}. The first validated MATCH assigns a program automatically. Later matching results preserve the active enrollment. Get its details through GET /me/program.
  Never commit populated credentials or runtime tokens.
}
