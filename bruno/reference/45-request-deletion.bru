meta {
  name: Request deletion
  type: http
  seq: 45
}

post {
  url: {{baseUrl}}/me/account-deletion
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "reauthenticationToken": "{{reauthenticationToken}}"
  }
}

script:post-response {
  const b=res.getBody(); if(b.trackingToken) bru.setVar("deletionToken",b.trackingToken);
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(202); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.1.0.
  Requires DELETE proof. Revokes all sessions. Does not cancel store subscriptions.
  Never commit populated credentials or runtime tokens.
}
