meta {
  name: Get scheduled meal details
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/me/meals/{{scheduledMealId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("HTTP status", function () { expect(res.getStatus()).to.equal(200); });
}

docs {
  Returns full details of a scheduled meal including items, portions, preparation, macros, and flags.
}
