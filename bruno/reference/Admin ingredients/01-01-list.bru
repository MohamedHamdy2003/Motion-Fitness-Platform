meta {
  name: 01-list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/ingredients
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Admin-only GET with no body; optional limit and offset query parameters. Lists ingredient lookup/content rows with slug, title, dietary tags, allergen codes, verification status and revision metadata. For one row use GET /admin/ingredients/{{ingredientId}}. Allergen codes come from GET /references/allergens.
  Never commit populated credentials or runtime tokens.
}
