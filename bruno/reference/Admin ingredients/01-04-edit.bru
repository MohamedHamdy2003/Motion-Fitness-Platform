meta {
  name: 04-edit
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/admin/ingredients/{{contentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "content": {
      "title": "Draft ingredient",
      "description": "Optional details displayed separately",
      "dietaryTags": [],
      "allergenCodes": [],
      "verificationStatus": "UNKNOWN"
    }
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  description is optional: omit it to preserve the saved description, send a string to replace it, or null to clear it. Other content fields shown above remain required. Success includes the saved ingredient and description.
  Never commit populated credentials or runtime tokens.
}
