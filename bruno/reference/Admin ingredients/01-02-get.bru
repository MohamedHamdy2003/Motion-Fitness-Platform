meta {
  name: 02-get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/ingredients/{{contentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Admin-only GET with no body. Returns the ingredient row including allergen_codes. Set ingredientId to an ID returned by GET /admin/ingredients.
  Never commit populated credentials or runtime tokens.
}
