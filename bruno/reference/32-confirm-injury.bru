meta {
  name: Confirm injury
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/me/injuries
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "body_area_code": "KNEE",
    "side": "LEFT",
    "description": "Final user-confirmed description",
    "confirmed": true
  }
}

script:post-response {
  const b=res.getBody(); if(b.injury) bru.setVar("injuryId",b.injury.id);
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(201); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.1.0.
  See docs/API_CONTRACT.md for response shapes and error codes.
  Never commit populated credentials or runtime tokens.
}
