meta {
  name: Readiness
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/health/ready
  body: none
  auth: none
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Public operational readiness probe. Response reports API and PostgreSQL/migration readiness plus provider configuration states. It does not collect a user's medical/health status, and it is not part of onboarding.
  Never commit populated credentials or runtime tokens.
}
