meta {
  name: Delete lookup value
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/admin/lookups/{{lookupTable}}/{{lookupCode}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Admin only. Set lookupTable to genders, primary-goals, fitness-levels, allergens or body-areas-injuries, and lookupCode to the value's code. Soft-deletes the lookup value by setting active=false. Existing profiles/program references are retained, but new requests cannot select the inactive code. Roles are fixed and cannot be modified through admin lookup endpoints.
}
