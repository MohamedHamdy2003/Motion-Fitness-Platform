meta {
  name: Delete lookup value
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/admin/lookups/fitness-levels/ADVANCED_PLUS
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Admin only. Soft-deletes the lookup value by setting active=false. Existing profiles/program references are retained, but new requests cannot select the inactive code. Built-in USER and ADMIN roles cannot be removed.
}
