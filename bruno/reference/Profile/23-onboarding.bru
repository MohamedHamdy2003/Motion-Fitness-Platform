meta {
  name: Onboarding
  type: http
  seq: 23
}

put {
  url: {{baseUrl}}/me/onboarding
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}


body:json {
  {
    "name": "Motion Athlete",
    "gender": "FEMALE",
    "height_cm": 175,
    "target_weight_kg": 72,
    "primary_goal": "FAT_LOSS",
    "fitness_level": "BEGINNER",
    "training_days_per_week": ["SUNDAY", "TUESDAY", "THURSDAY"],
    "timezone": "Africa/Cairo",
    "locale": "ar",
    "date_of_birth": "1998-03-14",
    "weight_kg": 80,
    "food_preferences": {
      "allergen_codes": ["MILK"],
      "disliked_food_ids": []
    }
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Required: name, gender, height_cm, weight_kg, target_weight_kg, primary_goal, fitness_level, training_days_per_week, timezone, locale, date_of_birth, food_preferences. target_weight_kg is a positive number and is editable later in PATCH /me. fitness_level must match a code returned by GET /references/onboarding; current seeded codes are BEGINNER, INTERMEDIATE, ADVANCED. food_preferences includes allergen_codes and disliked_food_ids; empty arrays mean no selections. Allergy codes come from GET /references/allergens and disliked food IDs from GET /references/foods. Preferences are saved atomically with onboarding and can later be edited through PUT /me/food-preferences. Age must be strictly over 18.
  Success example: {"status":"COMPLETED","matching":{"status":"PENDING","reason":"F05_NOT_IMPLEMENTED"}}. Matching remains PENDING until F05. Current and target weights are stored on the profile without measurement dates or history.
  /health/ready is an operational server/database check, not a personal health check.
  Never commit populated credentials or runtime tokens.
}
