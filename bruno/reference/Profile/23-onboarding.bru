meta {
  name: Onboarding
  type: http
  seq: 23
}

put {
  url: {{baseUrl}}/me/onboarding
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "expectedRevision": 0,
    "name": "Motion Athlete",
    "gender": "PREFER_NOT_TO_SAY",
    "height_cm": 175,
    "primary_goal": "FAT_LOSS",
    "fitness_level": "BEGINNER",
    "training_days_per_week": 3,
    "timezone": "Africa/Cairo",
    "locale": "ar",
    "date_of_birth": "1998-03-14",
    "weight_kg": 80
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Required: expectedRevision, name, gender, height_cm, weight_kg, primary_goal, fitness_level, training_days_per_week, timezone, locale, date_of_birth. gender: FEMALE | MALE | NON_BINARY | PREFER_NOT_TO_SAY. primary_goal: FAT_LOSS | STRENGTH_HYPERTROPHY. fitness_level: BEGINNER | INTERMEDIATE | ADVANCED. training_days_per_week is a count (2-5), not selected weekdays. Idempotency-Key is required (8-128 ASCII letters/digits/_/-). Age must be strictly over 18.
  Success example: {"status":"COMPLETED","profile_revision":1,"matching":{"status":"PENDING","reason":"F05_NOT_IMPLEMENTED"}}. Matching remains PENDING until F05. Current weight only; no target weight, measurement date or history.
  Onboarding fields are not food preferences or medical screening. Save food preferences separately with PUT /me/food-preferences. /health/ready is an operational server/database check, not a personal health check.
  Never commit populated credentials or runtime tokens.
}
