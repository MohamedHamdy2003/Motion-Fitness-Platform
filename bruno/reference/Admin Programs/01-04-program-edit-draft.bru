meta {
  name: 04-program-edit-draft
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/admin/programs/{{programId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

