meta {
  name: 02-program-create-draft
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/programs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

