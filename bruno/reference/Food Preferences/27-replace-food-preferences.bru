meta {
  name: Replace food preferences
  type: http
  seq: 27
}

put {
  url: {{baseUrl}}/me/food-preferences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "allergen_codes": [
      "MILK"
    ],
    "disliked_food_ids": []
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  This API is separate from PUT /me/onboarding. It replaces the whole preference selection after onboarding. Request: allergen_codes and disliked_food_ids arrays. Each allergen code must exist in GET /references/allergens. An unknown code returns 422 {"code":"ALLERGEN_CODE_NOT_FOUND","message":"Allergen code \"<code>\" is not registered...","details":{"allergen_code":"<code>"}} and the update is rolled back. The revision included in success responses is informational; send only the preference fields shown in the request body.
  Never commit populated credentials or runtime tokens.
}
