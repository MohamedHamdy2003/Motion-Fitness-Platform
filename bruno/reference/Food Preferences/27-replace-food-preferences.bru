meta {
  name: Replace food preferences
  type: http
  seq: 27
}

put {
  url: {{baseUrl}}/me/food-preferences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "expectedRevision": 0,
    "allergen_codes": [
      "MILK"
    ],
    "disliked_food_ids": [],
    "excluded_food_ids": []
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  This API is separate from PUT /me/onboarding. It replaces the whole preference selection after onboarding. Request: expectedRevision plus allergen_codes, disliked_food_ids and excluded_food_ids arrays. Success: {"revision":1,"allergen_codes":["MILK"],"disliked_food_ids":[],"excluded_food_ids":[]}. Read the current revision first with GET /me/food-preferences.
  Never commit populated credentials or runtime tokens.
}
