meta {
  name: Link Google identity
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/auth/identities/google/link
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "idToken": "{{idToken}}",
    "challengeId": "{{linkChallengeId}}",
    "reauthenticationToken": "{{reauthenticationToken}}"
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Final step of linking Google to the signed-in Motion account. It needs the current account Bearer token, a Google idToken created after the app used the nonce from POST /auth/challenges with purpose LINK, that challengeId, and a reauthenticationToken from POST /auth/reauthenticate with purpose LINK. Success: {"status":"LINKED","provider":"GOOGLE"}. This links the Google identity to this account; it does not merge accounts. If that Google identity belongs to another account, the request is rejected.
  Never commit populated credentials or runtime tokens.
}
