meta {
  name: Link Google identity
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/auth/identities/google/link
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "idToken": "{{idToken}}",
    "challengeId": "{{challengeId}}",
    "reauthenticationToken": "{{reauthenticationToken}}"
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Request: {"idToken":"<Google ID token issued using the LINK nonce>","challengeId":"<LINK challengeId>","reauthenticationToken":"<proof for purpose LINK>"}; current user Bearer token is also required. Success: {"status":"LINKED","provider":"GOOGLE"}. A provider identity already linked to another account is rejected.
  Never commit populated credentials or runtime tokens.
}
