meta {
  name: Reset password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "{{password}}",
    "confirmPassword": "{{password}}"
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Request: {"token":"{{resetToken}}","newPassword":"{{password}}","confirmPassword":"{{password}}"}. resetToken comes from successful Verify reset code (not the OTP itself). New password must be 8-128 characters and contain a number and a symbol. Success: {"status":"PASSWORD_CHANGED","requiresLogin":true}; all existing sessions are revoked.
  Never commit populated credentials or runtime tokens.
}
