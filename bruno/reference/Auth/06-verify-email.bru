meta {
  name: Verify email
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/verify-email
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "code": "{{otpCode}}"
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Request: {"email":"{{email}}","code":"{{otpCode}}"} where code is the six-digit OTP from email. Success: {"status":"VERIFIED"}. This confirms email but does not issue a session; call Login next.
  Never commit populated credentials or runtime tokens.
}
