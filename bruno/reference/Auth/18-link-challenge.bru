meta {
  name: Link challenge
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/auth/challenges
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "provider": "GOOGLE",
    "purpose": "LINK"
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(201); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Request: {"provider":"GOOGLE","purpose":"LINK"}; Bearer token for the account to link is required. Response: {"challengeId":"<uuid>","nonce":"<random-string>","expiresIn":300}. Pass the nonce to native Google Sign-In. Then reauthenticate the current account and call Link Google identity with idToken, challengeId and reauthenticationToken.
  Never commit populated credentials or runtime tokens.
}
