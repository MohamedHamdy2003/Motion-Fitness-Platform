meta {
  name: Social reauthentication
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/auth/reauthenticate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "method": "GOOGLE",
    "idToken": "{{idToken}}",
    "challengeId": "{{reauthChallengeId}}",
    "purpose": "LINK"
  }
}

script:post-response {
  const b=res.getBody(); if(b.reauthenticationToken) bru.setVar("reauthenticationToken",b.reauthenticationToken);
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  This endpoint verifies the signed-in account again; it does not create a new login session. For method=GOOGLE first call POST /auth/challenges with {"provider":"GOOGLE","purpose":"REAUTHENTICATE"}, pass its nonce to Google Sign-In, then send that idToken and challengeId here. purpose=LINK returns a short-lived reauthenticationToken required by the final link request. For a password account, use method=PASSWORD and the current password instead; no social challenge is needed.
  Never commit populated credentials or runtime tokens.
}
