meta {
  name: Social reauthentication challenge
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/auth/challenges
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "provider": "GOOGLE",
    "purpose": "REAUTHENTICATE"
  }
}

script:post-response {
  const b=res.getBody(); if(b.challengeId) bru.setVar("reauthChallengeId",b.challengeId);
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(201); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  This challenge is only for proving an already-linked Google/Apple identity belongs to the signed-in Motion account again. It requires Bearer auth. Request {"provider":"GOOGLE","purpose":"REAUTHENTICATE"}, pass its nonce to Google Sign-In, then POST the returned idToken and reauthChallengeId to /auth/reauthenticate with method=GOOGLE and purpose=LINK or DELETE. This does not sign in or link another identity.
  Never commit populated credentials or runtime tokens.
}
