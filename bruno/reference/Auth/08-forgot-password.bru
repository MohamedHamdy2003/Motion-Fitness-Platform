meta {
  name: Forgot password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(202); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Request: {"email":"{{email}}"}. Always returns HTTP 202 and a generic {"status":"ACCEPTED","message":"If the account is eligible, an email will be sent."} response to avoid revealing whether an account exists. If eligible, enter the emailed OTP in Verify reset code to receive resetToken.
  Never commit populated credentials or runtime tokens.
}
