meta {
  name: Register
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(201); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Requires real email transport or local capture; returns 503 EMAIL_NOT_CONFIGURED otherwise. Success creates an unverified user, returns emailDelivery QUEUED and nextStep VERIFY_EMAIL, and issues no session tokens. Verify the OTP, then call Login.
  Never commit populated credentials or runtime tokens.
}
