meta {
  name: Register
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const b = res.getBody(); if (b.accessToken) { bru.setVar("accessToken", b.accessToken); bru.setVar("refreshToken", b.refreshToken); }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(201); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Request: {"email":"{{email}}","password":"{{password}}"}; new password must be 8-128 characters with at least one number and one symbol. Success: {"user":{"id":"<uuid>","email":"<normalized-email>","verified":false},"emailDelivery":"QUEUED","nextStep":"VERIFY_EMAIL"}. Registration does not issue tokens. Verify the OTP, then call Login. Requires configured email delivery; otherwise 503 EMAIL_NOT_CONFIGURED.
  Never commit populated credentials or runtime tokens.
}
