meta {
  name: Google challenge
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/challenges
  body: json
  auth: none
}

body:json {
  {
    "provider": "GOOGLE",
    "purpose": "SIGN_IN"
  }
}

script:post-response {
  const b=res.getBody(); if(b.challengeId) bru.setVar("signInChallengeId",b.challengeId);
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(201); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  First step of signing into Motion with Google. The app requests a short-lived, one-use challenge without a Bearer token: {"provider":"GOOGLE","purpose":"SIGN_IN"}. The response has challengeId, nonce and expiresIn=300 seconds. Bruno stores this ID as signInChallengeId. The app passes nonce into native Google Sign-In, then sends Google's idToken and challengeId to POST /auth/google. That endpoint validates the token and issues Motion session tokens. Bruno cannot create a real Google idToken.
  Never commit populated credentials or runtime tokens.
}
