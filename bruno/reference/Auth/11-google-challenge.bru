meta {
  name: Google challenge
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/challenges
  body: json
  auth: none
}

body:json {
  {
    "provider": "GOOGLE",
    "purpose": "SIGN_IN"
  }
}

script:post-response {
  const b=res.getBody(); if(b.challengeId) bru.setVar("challengeId",b.challengeId);
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(201); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Request: {"provider":"GOOGLE","purpose":"SIGN_IN"}. Response: {"challengeId":"<uuid>","nonce":"<random-string>","expiresIn":300}. The mobile app passes nonce to Google Sign-In and then sends the resulting idToken plus this challengeId to Google sign-in. Bruno does not mint Google tokens.
  Never commit populated credentials or runtime tokens.
}
