meta {
  name: Password reauthentication
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/auth/reauthenticate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "method": "PASSWORD",
    "password": "{{password}}",
    "purpose": "LINK"
  }
}

script:post-response {
  const b=res.getBody(); if(b.reauthenticationToken) bru.setVar("reauthenticationToken",b.reauthenticationToken);
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Re-proves ownership of the signed-in password account. Set purpose to LINK before linking Google/Apple or DELETE before account deletion. The response contains a short-lived reauthenticationToken scoped to that purpose.
  Never commit populated credentials or runtime tokens.
}
