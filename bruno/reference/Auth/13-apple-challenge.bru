meta {
  name: Apple challenge
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/auth/challenges
  body: json
  auth: none
}

body:json {
  {
    "provider": "APPLE",
    "purpose": "SIGN_IN"
  }
}

script:post-response {
  const b=res.getBody(); if(b.challengeId) bru.setVar("signInChallengeId",b.challengeId);
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(201); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  First Apple sign-in step. Send this nonce into native Sign in with Apple, then send its idToken, authorizationCode and this challengeId to POST /auth/apple. It expires in five minutes and can be used once.
  Never commit populated credentials or runtime tokens.
}
