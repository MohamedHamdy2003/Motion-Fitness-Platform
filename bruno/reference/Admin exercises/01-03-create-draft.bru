meta {
  name: 03-create-draft
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/exercises
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "slug": "replace-with-unique-slug",
    "content": {
      "title": "Draft exercise",
      "description": "Replace with sourced editorial content",
      "instructions": [
        "Replace with reviewed movement instructions"
      ],
      "muscleGroups": [
        "Replace"
      ],
      "equipment": [],
      "source": {
        "title": "Required source",
        "reference": "Required source record or URL",
        "licenseNotes": "Required reuse notes"
      },
      "mediaId": null
    }
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(201); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  See docs/API_CONTRACT.md for response shapes and error codes.
  Never commit populated credentials or runtime tokens.
}
