meta {
  name: 01-food-sections-list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/food-sections
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Admin-only GET with no body; optional limit and offset query parameters. Lists food exchange groups with metadata for their latest versions. Use the ID with GET /admin/food-sections/{{foodSectionId}} for version and member details.
  Never commit populated credentials or runtime tokens.
}
