meta {
  name: 11-meals-list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/meals
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Admin-only GET with no body; optional limit and offset query parameters. Lists saved meals and the latest version metadata. Use GET /admin/meals/{{mealId}} to read a meal's versions and saved meal_items.
  Never commit populated credentials or runtime tokens.
}
