meta {
  name: 22-meal-item-edit
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/admin/meals/{{mealId}}/items/{{mealItemPosition}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "expectedRevision": 1,
    "exchangeUnits": 1.5
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Admin-only PATCH. Any combination of memberId, exchangeUnits and position may be changed. expectedRevision prevents overwriting a newer edit. Published meals are copied into a new draft before modification.
}
