meta {
  name: 12-meal-create-draft
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/meals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "slug": "replace-with-unique-meal-slug",
    "sectionId": "{{mealSectionId}}",
    "title": "Draft meal idea",
    "items": [
      {
        "memberId": "{{foodMemberId}}",
        "exchangeUnits": 1,
        "position": 0
      }
    ]
  }
}

script:post-response {
  const b=res.getBody(); if(b.id) bru.setVar("mealId",b.id); if(b.version_id) bru.setVar("mealVersionId",b.version_id);
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(201); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  See docs/API_CONTRACT.md for response shapes and error codes.
  Never commit populated credentials or runtime tokens.
}
