meta {
  name: 20-meal-item-get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/meals/{{mealId}}/items/{{mealItemPosition}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Admin-only GET. A meal item is identified by its position within the latest meal version. Set mealId and mealItemPosition from GET /admin/meals/{{mealId}}/items.
}
