meta {
  name: 07-meal-sections-list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/meal-sections
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Admin-only GET with no body; optional limit and offset query parameters. Lists saved meal sections and their published meal counts. Use the ID when creating or editing a meal.
  Never commit populated credentials or runtime tokens.
}
