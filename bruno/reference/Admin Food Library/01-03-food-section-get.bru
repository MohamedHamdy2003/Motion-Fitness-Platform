meta {
  name: 03-food-section-get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/food-sections/{{foodSectionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  const b=res.getBody(); const v=(b.versions||[]).find(x=>x.status==="PUBLISHED")||(b.versions||[])[0]; if(v&&v.members&&v.members[0]) bru.setVar("foodMemberId",v.members[0].id);
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Admin-only GET with no body. Returns the group and its versions with food members and portion details. Set foodSectionId from GET /admin/food-sections; the response also stores a member ID for meal creation.
  Never commit populated credentials or runtime tokens.
}
