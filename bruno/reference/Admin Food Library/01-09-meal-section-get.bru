meta {
  name: 09-meal-section-get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/meal-sections/{{mealSectionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Admin-only GET with no body. Returns the meal section and its number of saved versions. Set mealSectionId from GET /admin/meal-sections.
  Never commit populated credentials or runtime tokens.
}
