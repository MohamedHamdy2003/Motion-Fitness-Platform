meta {
  name: 13-meal-get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/meals/{{mealId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Admin-only GET with no body. Returns the meal and all versions; each version includes its saved items (meal_items), exchange units, positions, linked food/food version IDs, portion display and food status. Set mealId from GET /admin/meals.
  Never commit populated credentials or runtime tokens.
}
