meta {
  name: 01-list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/foods
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Admin-only GET with no body; optional limit and offset query parameters. Lists food records with their latest saved version and content. Use GET /admin/foods/{{foodId}} for all revisions.
  Never commit populated credentials or runtime tokens.
}
