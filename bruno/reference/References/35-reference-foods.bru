meta {
  name: Reference foods
  type: http
  seq: 35
}

get {
  url: {{baseUrl}}/references/foods
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Request: GET with no body; optional query parameters search, limit (1-100, default 30), offset (default 0). Returns matching published food and ingredient choices as {"items":[{"id":"<uuid>","name":"Chicken breast","kind":"FOOD"}],"limit":30,"offset":0,"contentStatus":"READY"}. Use returned IDs for food preference dislikes/exclusions.
  Never commit populated credentials or runtime tokens.
}
