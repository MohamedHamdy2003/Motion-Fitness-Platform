meta {
  name: Reference allergens
  type: http
  seq: 34
}

get {
  url: {{baseUrl}}/references/allergens
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Response shape: {"items":[{"code":"MILK","label":"Milk"}]}. Possible starter codes: MILK, EGG, PEANUT, TREE_NUT, SOY, WHEAT, FISH, CRUSTACEAN, SESAME. These are rows in the allergens lookup table (code is its primary key), not a TypeScript or PostgreSQL enum. Food preference or ingredient requests using an unregistered code fail with 422 ALLERGEN_CODE_NOT_FOUND and identify the rejected code; read this endpoint for the accepted values.
  Never commit populated credentials or runtime tokens.
}
