meta {
  name: Reference body-areas
  type: http
  seq: 33
}

get {
  url: {{baseUrl}}/references/body-areas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Request: GET with no body. Returns {"items":[{"code":"ANKLE","parent_code":null}]}. These codes come from the body_areas_injuries lookup table and are accepted by POST/PATCH /me/injuries. The public route remains /references/body-areas for API compatibility.
  Never commit populated credentials or runtime tokens.
}
