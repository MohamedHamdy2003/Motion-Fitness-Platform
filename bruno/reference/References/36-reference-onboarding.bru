meta {
  name: Reference onboarding
  type: http
  seq: 36
}

get {
  url: {{baseUrl}}/references/onboarding
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Server request ID", function () { expect(res.getHeader("x-request-id")).to.be.a("string"); });
}

docs {
  Contract version: v1 / 0.4.0.
  Response example: {"primary_goals":[{"code":"FAT_LOSS","label":"Fat loss","display_order":1},{"code":"STRENGTH_HYPERTROPHY","label":"Strength & hypertrophy","display_order":2}],"genders":["FEMALE","MALE"],"fitness_levels":[{"code":"BEGINNER","label":"Beginner","display_order":1},{"code":"INTERMEDIATE","label":"Intermediate","display_order":2},{"code":"ADVANCED","label":"Advanced","display_order":3}],"training_days_per_week":["SUNDAY","MONDAY","TUESDAY","WEDNESDAY","THURSDAY","FRIDAY","SATURDAY"],"training_days_per_week_count":[2,3,4,5],"minimum_age":18,"minimum_age_inclusive":false,"policyStatus":"CONFIGURED"}. Gender, primary-goal and fitness-level values are read from seeded lookup tables. Select a primary goal and fitness level by code and 2-5 unique weekdays for onboarding.
  Never commit populated credentials or runtime tokens.
}
