Project Motion_Fitness_Platform {
  database_type: 'PostgreSQL'
  Note: 'Relationship-focused ERD for the current dev schema. Includes all application tables, one view, and foreign-key relationships after migrations on dev. Selected non-key columns are included for readability.'
}

Table users {
  id uuid [pk]
  email_normalized text [unique]
}

Table rate_limits {
  key text [pk]
  bucket bigint [pk]
}

Table roles {
  code text [pk, note: 'Current dev values: ATHLETE, CONTENT_EDITOR, NUTRITION_REVIEWER, EXERCISE_REVIEWER, ADMIN']
}

Table user_roles {
  user_id uuid [pk]
  role_code text [pk]
}

Table auth_sessions {
  id uuid [pk]
  user_id uuid
  family_id uuid
}

Table auth_refresh_tokens {
  id uuid [pk]
  session_id uuid
  parent_token_id uuid [unique]
}

Table verification_tokens {
  id uuid [pk]
  user_id uuid
  session_id uuid
  purpose text
  is_otp boolean
}

Table auth_challenges {
  id uuid [pk]
  user_id uuid
  provider text
  purpose text
}

Table auth_identities {
  id uuid [pk]
  user_id uuid
  provider text
  provider_subject text
  indexes {
    (provider, provider_subject) [unique]
    (user_id, provider) [unique]
  }
}

Table media_assets {
  id uuid [pk]
  owner_user_id uuid
  storage_key text [unique]
  upload_key text
  library_asset boolean
}

Table genders {
  code text [pk, note: 'Current values: MALE, FEMALE']
}

Table user_profiles {
  user_id uuid [pk]
  gender text
  primary_goal text [note: 'CHECK values: FAT_LOSS, STRENGTH_HYPERTROPHY']
  fitness_level text [note: 'CHECK values: BEGINNER, INTERMEDIATE, ADVANCED']
  avatar_media_id uuid
  weight_kg numeric
}

Table user_settings {
  user_id uuid [pk]
}

Table body_areas_injuries {
  code text [pk, note: 'Seeded body-area reference codes']
  parent_code text
}

Table allergens {
  code text [pk, note: 'Seeded allergen reference codes']
  label text
}

Table user_restriction_states {
  user_id uuid [pk]
  injury_revision integer
}

Table user_injuries {
  id uuid [pk]
  user_id uuid
  body_area_code text
}

Table user_food_preferences {
  user_id uuid [pk]
  revision integer
}

Table user_allergies {
  user_id uuid [pk]
  allergen_code text [pk]
}

Table food_reference_items {
  id uuid [pk]
  description text
  name text
  kind text
}

Table user_disliked_foods {
  user_id uuid [pk]
  food_id uuid [pk]
}

Table jobs {
  id uuid [pk]
  user_id uuid
}

Table account_deletions {
  id uuid [pk]
  user_id uuid [unique]
  tracking_hash text [unique]
}


Table domain_events {
  id uuid [pk]
  user_id uuid
}

Table ai_rewrite_runs {
  id uuid [pk]
  user_id uuid
}

Table content_seed_imports {
  dataset_id text [pk]
  version integer [pk]
}

Table exercises {
  id uuid [pk]
  slug text [unique]
}

Table exercise_revisions {
  id uuid [pk]
  exercise_id uuid
  version integer
  media_id uuid
  indexes {
    (exercise_id, version) [unique]
  }
}

Table ingredients {
  id uuid [pk]
  slug text [unique]
  title text
}

Table ingredient_allergens {
  ingredient_id uuid [pk]
  allergen_code text [pk]
}

Table foods {
  id uuid [pk]
  slug text [unique]
}

Table food_versions {
  id uuid [pk]
  food_id uuid
  version integer
  media_id uuid
  indexes {
    (food_id, version) [unique]
  }
}

Table food_ingredients {
  food_version_id uuid [pk]
  ingredient_id uuid [pk]
  quantity_g numeric
}

Table food_exchange_groups {
  id uuid [pk]
  slug text [unique]
}

Table food_exchange_group_versions {
  id uuid [pk]
  group_id uuid
  version integer
  indexes {
    (group_id, version) [unique]
  }
}

Table food_exchange_members {
  id uuid [pk]
  group_version_id uuid
  food_version_id uuid
  indexes {
    (group_version_id, food_version_id) [unique]
  }
}

Table meal_sections {
  id uuid [pk]
  slug text [unique]
}

Table meals {
  id uuid [pk]
  slug text [unique]
}

Table meal_versions {
  id uuid [pk]
  meal_id uuid
  section_id uuid
  version integer
  indexes {
    (meal_id, version) [unique]
  }
}

Table meal_items {
  meal_version_id uuid [pk]
  position integer [pk]
  default_exchange_member_id uuid
}

Table programs {
  id uuid [pk]
  slug text [unique]
}

Table program_versions {
  id uuid [pk]
  program_id uuid
  primary_goal text [note: 'CHECK values: FAT_LOSS, STRENGTH_HYPERTROPHY']
  supported_goals text[]
  ideal_level text [note: 'CHECK values: BEGINNER, INTERMEDIATE, ADVANCED']
  supported_levels text[]
  nutrition_plan_version_id uuid [unique]
  approved_hint_version_id uuid
  version integer
  indexes {
    (program_id, version) [unique]
  }
}

Table nutrition_plans {
  id uuid [pk]
  slug text [unique]
}

Table nutrition_plan_versions {
  id uuid [pk]
  nutrition_plan_id uuid
  version integer
  indexes {
    (nutrition_plan_id, version) [unique]
    (id, nutrition_plan_id) [unique]
  }
}

Table nutrition_template_days {
  id uuid [pk]
  nutrition_plan_version_id uuid
  day_position integer
  indexes {
    (nutrition_plan_version_id, day_position) [unique]
    (id, nutrition_plan_version_id) [unique]
  }
}

Table meal_slots {
  id uuid [pk]
  template_day_id uuid
  default_meal_version_id uuid
  position integer
  indexes {
    (template_day_id, position) [unique]
  }
}

Table workouts {
  id uuid [pk]
  slug text [unique]
}

Table workout_revisions {
  id uuid [pk]
  workout_id uuid
  version integer
  indexes {
    (workout_id, version) [unique]
  }
}

Table workout_exercises {
  id uuid [pk]
  workout_revision_id uuid
  exercise_revision_id uuid
  position integer
  indexes {
    (workout_revision_id, position) [unique]
  }
}

Table monthly_plans {
  id uuid [pk]
  program_version_id uuid
  position integer
  indexes {
    (program_version_id, position) [unique]
  }
}

Table plan_weeks {
  id uuid [pk]
  monthly_plan_id uuid
  position integer
  indexes {
    (monthly_plan_id, position) [unique]
  }
}

Table plan_days {
  id uuid [pk]
  week_id uuid
  workout_revision_id uuid
  nutrition_template_day_id uuid [unique]
  position integer
  indexes {
    (week_id, position) [unique]
  }
}

Table program_hint_versions {
  id uuid [pk]
  program_version_id uuid
  approved_by uuid
  version integer
  indexes {
    (program_version_id, version) [unique]
  }
}

Table available_food_references {
  id uuid [pk, note: 'VIEW, derived from food_reference_items, foods, food_versions and ingredients']
}

// Identity and authentication
Ref: user_roles.user_id > users.id [delete: cascade]
Ref: user_roles.role_code > roles.code
Ref: auth_sessions.user_id > users.id [delete: cascade]
Ref: auth_refresh_tokens.session_id > auth_sessions.id [delete: cascade]
Ref: auth_refresh_tokens.parent_token_id - auth_refresh_tokens.id [delete: cascade]
Ref: verification_tokens.user_id > users.id [delete: cascade]
Ref: verification_tokens.session_id > auth_sessions.id [delete: cascade]
Ref: auth_challenges.user_id > users.id [delete: cascade]
Ref: auth_identities.user_id > users.id [delete: cascade]
Ref: media_assets.owner_user_id > users.id [delete: cascade]

// Profile, lookups, preferences and restrictions
Ref: user_profiles.user_id - users.id [delete: cascade]
Ref: user_profiles.gender > genders.code
Ref: user_profiles.avatar_media_id > media_assets.id [delete: set null]
Ref: user_settings.user_id - users.id [delete: cascade]
Ref: body_areas_injuries.parent_code > body_areas_injuries.code
Ref: user_restriction_states.user_id - users.id [delete: cascade]
Ref: user_injuries.user_id > users.id [delete: cascade]
Ref: user_injuries.body_area_code > body_areas_injuries.code
Ref: user_food_preferences.user_id - users.id [delete: cascade]
Ref: user_allergies.user_id > users.id [delete: cascade]
Ref: user_allergies.allergen_code > allergens.code
Ref: user_disliked_foods.user_id > users.id [delete: cascade]
Ref: user_disliked_foods.food_id > food_reference_items.id

// User lifecycle and operational records
Ref: jobs.user_id > users.id [delete: cascade]
Ref: account_deletions.user_id - users.id [delete: set null]
Ref: domain_events.user_id > users.id [delete: cascade]
Ref: ai_rewrite_runs.user_id > users.id [delete: cascade]

// Exercise catalog
Ref: exercise_revisions.exercise_id > exercises.id
Ref: exercise_revisions.media_id > media_assets.id
Ref: workout_revisions.workout_id > workouts.id
Ref: workout_exercises.workout_revision_id > workout_revisions.id
Ref: workout_exercises.exercise_revision_id > exercise_revisions.id

// Food, ingredients and meals
Ref: foods.id - food_reference_items.id
Ref: ingredients.id - food_reference_items.id
Ref: ingredient_allergens.ingredient_id > ingredients.id
Ref: ingredient_allergens.allergen_code > allergens.code
Ref: food_versions.food_id > foods.id
Ref: food_versions.media_id > media_assets.id
Ref: food_ingredients.food_version_id > food_versions.id [delete: cascade]
Ref: food_ingredients.ingredient_id > ingredients.id
Ref: food_exchange_group_versions.group_id > food_exchange_groups.id
Ref: food_exchange_members.group_version_id > food_exchange_group_versions.id
Ref: food_exchange_members.food_version_id > food_versions.id
Ref: meal_versions.meal_id > meals.id
Ref: meal_versions.section_id > meal_sections.id
Ref: meal_items.meal_version_id > meal_versions.id [delete: cascade]
Ref: meal_items.default_exchange_member_id > food_exchange_members.id

// Programs, workout plans and nutrition plans
Ref: program_versions.program_id > programs.id
Ref: program_versions.nutrition_plan_version_id - nutrition_plan_versions.id
Ref: program_versions.approved_hint_version_id > program_hint_versions.id
Ref: nutrition_plan_versions.nutrition_plan_id > nutrition_plans.id
Ref: nutrition_template_days.nutrition_plan_version_id > nutrition_plan_versions.id
Ref: meal_slots.template_day_id > nutrition_template_days.id
Ref: meal_slots.default_meal_version_id > meal_versions.id
Ref: monthly_plans.program_version_id > program_versions.id
Ref: plan_weeks.monthly_plan_id > monthly_plans.id
Ref: plan_days.week_id > plan_weeks.id
Ref: plan_days.workout_revision_id > workout_revisions.id
Ref: plan_days.nutrition_template_day_id - nutrition_template_days.id
Ref: program_hint_versions.program_version_id > program_versions.id
Ref: program_hint_versions.approved_by > users.id
