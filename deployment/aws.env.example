# Copy to .env.aws on EC2 only. Do not commit real values.
NODE_ENV=production
PORT=3100
DATABASE_URL=postgres://DB_USER:URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/DB_NAME
DATABASE_SSL=true
DATABASE_CA_CERT_PATH=/run/certs/rds-ca.pem
JWT_SECRET=
JWT_ISSUER=motion-api
JWT_AUDIENCE=motion-mobile
MAIL_MODE=disabled
MAIL_ENCRYPTION_KEY=
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CLIENT_IDS=
S3_AUTH_MODE=iam
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public IP used by Caddy for ACME short-lived certificates. Keep this IP stable.
API_DOMAIN=13.49.114.20
# AWS Compose enforces one trusted proxy hop; API has no published host port.
TRUST_PROXY=true
CORS_ORIGINS=
AI_RETENTION_APPROVED=false
DELETION_RETENTION_APPROVED=false
