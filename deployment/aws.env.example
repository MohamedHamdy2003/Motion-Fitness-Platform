# Copy to .env.aws on EC2 only. Do not commit real values.
NODE_ENV=production
PORT=3100
DATABASE_URL=postgres://DB_USER:URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/DB_NAME
DATABASE_SSL=true
DATABASE_CA_CERT_PATH=/run/certs/rds-ca.pem
JWT_SECRET=
JWT_ISSUER=motion-api
JWT_AUDIENCE=motion-mobile
MAIL_MODE=disabled
MAIL_ENCRYPTION_KEY=
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CLIENT_IDS=
S3_AUTH_MODE=iam
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public IP used by Caddy for ACME short-lived certificates. Keep this IP stable.
API_DOMAIN=13.49.114.20
# AWS Compose enforces one trusted proxy hop; API has no published host port.
TRUST_PROXY=true
CORS_ORIGINS=
API_RATE_LIMIT_PER_MINUTE=600
AI_RETENTION_APPROVED=false
DELETION_RETENTION_APPROVED=false

# Private Mastra AI sidecar (Gemini remote model); enable once AI_RETENTION_APPROVED=true.
GEMINI_API_KEY=
AI_MODEL=google/gemini-3.5-flash-lite
AI_SERVICE_TOKEN=
AI_MATCHING_URL=http://ai:3001/internal/v1/match
AI_REWRITE_URL=http://ai:3001/internal/v1/rewrite
AI_FITTING_URL=http://ai:3001/internal/v1/fit

# Firebase Cloud Messaging (FCM HTTP v1) push notifications.
# Option 1 (recommended): base64-encoded Firebase Service Account JSON (single line).
FCM_SERVICE_ACCOUNT_BASE64=
# Option 2: separate Service Account fields (leave empty if using FCM_SERVICE_ACCOUNT_BASE64).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
