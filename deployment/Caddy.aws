{
	default_sni {$API_DOMAIN:13.49.114.20}
}

{$API_DOMAIN:13.49.114.20} {
	tls {
		issuer acme {
			profile shortlived
		}
	}

	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3100
	}

	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
